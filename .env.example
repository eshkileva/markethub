# Copy to .env for local docker compose + app config

NODE_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://markethub:markethub@localhost:5432/markethub
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-cookie-secret
REFRESH_COOKIE_NAME=mh_refresh

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=markethub
S3_ACCESS_KEY=markethub
S3_SECRET_KEY=markethubsecret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/markethub

RABBITMQ_URL=amqp://markethub:markethub@localhost:5672
RABBITMQ_ENABLED=false

# Optional integrations (never commit real keys)
GEOHELPER_API_KEY=
# FX uses free open.er-api.com (RUB/BYN/KZT, no key). CurrencyAPI is fallback only.
CURRENCYAPI_KEY=
MOBILEAPI_KEY=
APIFY_TOKEN=
FX_CACHE_TTL_SECONDS=3600

# Email (optional). Without SMTP_HOST codes are logged to the API console in dev.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@kupilko.store
# SMTP_PASS=
# EMAIL_FROM=noreply@kupilko.store

# AI Listing Copilot (OpenRouter). Without OPENROUTER_API_KEY copilot UI stays hidden.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
# AI_COPILOT_DAILY_LIMIT=20

VITE_API_URL=http://localhost:3000
# In `vite dev` the browser talks to the same origin; Vite proxies /v1 to the API above.
# Keep VITE_API_URL for production builds.
