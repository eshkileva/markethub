# Copy to .env on the VPS. Do not commit.

NODE_ENV=production
LOG_LEVEL=info
ACME_EMAIL=you@kupilko.store

# Hostnames only (no https://). DNS A-records for both must point at this VPS.
API_SITE=api.kupilko.store
MEDIA_SITE=media.kupilko.store

PUBLIC_API_URL=https://api.kupilko.store
WEB_ORIGIN=https://kupilko.store

POSTGRES_PASSWORD=generate-a-long-password
JWT_SECRET=generate-at-least-32-random-chars
COOKIE_SECRET=generate-at-least-16-random-chars
REFRESH_COOKIE_NAME=mh_refresh

S3_REGION=us-east-1
S3_BUCKET=markethub
S3_ACCESS_KEY=generate-minio-user
S3_SECRET_KEY=generate-minio-secret
S3_PUBLIC_URL=https://media.kupilko.store/markethub

RABBITMQ_ENABLED=false
# First deploy: true once, then set false — seed loads docs/*.json and can take minutes.
SEED_ON_START=false

GEOHELPER_API_KEY=
CURRENCYAPI_KEY=
MOBILEAPI_KEY=
APIFY_TOKEN=
FX_CACHE_TTL_SECONDS=3600

# Outbound email for verification codes (Yandex, Mail.ru, SendGrid SMTP relay, etc.)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@kupilko.store
SMTP_PASS=generate-app-password
EMAIL_FROM=noreply@kupilko.store

# AI Listing Copilot (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
AI_COPILOT_DAILY_LIMIT=20
