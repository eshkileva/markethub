# Copy to `.env` on the server. Never commit `.env`.

NODE_ENV=production
LOG_LEVEL=info
ACME_EMAIL=admin@example.com

# Public hostnames (Caddy + CORS). Must share one registrable domain with the web app.
API_SITE=api.example.com
MEDIA_SITE=media.example.com
PUBLIC_API_URL=https://api.example.com
WEB_ORIGIN=https://example.com
S3_PUBLIC_URL=https://media.example.com/markethub

POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
REFRESH_COOKIE_NAME=mh_refresh

S3_REGION=us-east-1
S3_BUCKET=markethub
S3_ACCESS_KEY=
S3_SECRET_KEY=

RABBITMQ_ENABLED=false
SEED_ON_START=false
